DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///backend/db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USE_HTTPS=False

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
TO_EMAIL=recipient@example.com
FROM_EMAIL=your_email@example.com

MAX_WORKERS=16
APPLIST_PAGE_SIZE=50000
STEAM_API_KEY=replace_with_your_steam_web_api_key
FETCH_FOLLOWERS=true
FOLLOWER_FETCH_DELAY=0.1
FOLLOWER_SAMPLE_RATE=1.0
FETCH_WISHLIST_RANK=true
WISHLIST_RANK_MIN_FOLLOWERS=300
WISHLIST_RANK_DELAY=0.5

FEISHU_WEBHOOK_URL=
